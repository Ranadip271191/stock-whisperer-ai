# --- LLM provider credentials -------------------------------------------------
OPENAI_API_KEY=
# Optional. Leave empty to route every agent through the OpenAI/Azure client.
ANTHROPIC_API_KEY=

# --- Endpoint -----------------------------------------------------------------
# Leave empty to use api.openai.com with an sk-... platform key.
# For Azure AI Foundry, set the OpenAI-compatible v1 endpoint and use your
# Azure resource key above:
#   OPENAI_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1
OPENAI_BASE_URL=

# --- Model selection ----------------------------------------------------------
# On Azure this is the DEPLOYMENT name, not the model name.
OPENAI_CHAT_MODEL_ID=gpt-4.1
ANTHROPIC_MODEL_ID=claude-sonnet-4-5-20250929

# --- Kite Connect (deterministic intraday runner, src/stock_agents/kite/) -----
# KITE_ACCESS_TOKEN expires daily; run `python -m stock_agents.kite.login` each
# morning to refresh it. Never commit real values.
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
